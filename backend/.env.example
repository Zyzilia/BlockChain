# Salin menjadi .env. JANGAN commit file .env
PORT=3000
# Buat nilai acak dengan: npm run gen:keys
JWT_SECRET=
DB_PATH=./db/tiketaman.db
# Hanya email berakhiran ini yang boleh mendaftar (data dummy: student.ub.ac.id)
ALLOWED_EMAIL_SUFFIX=.ac.id, @gmail.com

# Midtrans Sandbox (Tahap 4)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Blockchain Sepolia (Tahap 2/5)
# RPC_URL: URL HTTPS Sepolia dari Alchemy/Infura
# PLATFORM_PRIVATE_KEY: private key akun MetaMask KHUSUS testnet (jangan wallet utama)
# CONTRACT_ADDRESS: diisi setelah deploy
RPC_URL=
PLATFORM_PRIVATE_KEY=
CONTRACT_ADDRESS=
# Kunci untuk mengenkripsi private key wallet custodial (32 karakter)
WALLET_ENC_KEY=
